<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/fitdex_splash_spartan_background</item>
        <item name="windowSplashScreenBackground">@color/fitdex_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/fitdex_splash_spartan</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Spartan" parent="AppTheme.NoActionBarLaunch">
        <item name="android:windowBackground">@drawable/fitdex_splash_spartan_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/fitdex_splash_spartan</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Amazonian" parent="AppTheme.NoActionBarLaunch">
        <item name="android:windowBackground">@drawable/fitdex_splash_amazonian_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/fitdex_splash_amazonian</item>
    </style>
</resources>
